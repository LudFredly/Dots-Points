# Firebase Web SDK Configuration
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app -> SDK setup/configuration (Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Access Control Keys
# ACCESS_KEY: Key required by regular team members to unlock and use the portal.
# Leave blank to keep portal open without a gate.
VITE_ACCESS_KEY=

# ADMIN_EMAIL (Optional): The email assigned to your single admin user in Firebase Authentication.
# Defaults automatically to admin@<projectId>.internal if left blank.
# NOTE: The secret admin password/key is NOT stored here or in the source code;
# it is only passed via your private secret URL (e.g. /admin?secret=YOUR_KEY).
VITE_ADMIN_EMAIL=

